{
  name: "x-alp"
  target_dir: "x-alp"

  upstream: {
    url: "https://github.com/x-heep/x-alp.git"
    rev: "c8013eeec3aa274cb91170537cf67971ad67dc3a"
  }

  exclude_from_upstream: [
    ".github"
    // Generated by mcu-gen from GR-ALP's config, but tracked by X-ALP: they would
    // show up as changes to the vendored copy (also listed in .gitignore)
    "hw/x_alp.sv"
    "hw/system/core_v_mcu.sv"
    "hw/include/cva6_config_pkg.sv"
    "hw/ip/fast_intr_ctrl/rtl/fast_intr_ctrl_reg_pkg.sv"
    "hw/ip/soc_ctrl/rtl/soc_ctrl_reg_pkg.sv"
    "hw/ip/pad_control/rtl/pad_control_reg_pkg.sv"
    "sw/device/lib/runtime/core_v_mcu.h"
    "sw/linker/common.ldh"
    "docs/addressmap.md"
  ]
}
